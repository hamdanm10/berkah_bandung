<div class="flex items-center justify-between">
  <div class="flex gap-4 items-center">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: warehouse_admin_products_path)) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <h2 class="text-xl font-bold text-gray-700">Import Product</h2>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: warehouse_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: warehouse_admin_products_path, name: "Products")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Import Product", last: true)) %>
    <% end %>
  </div>
</div>
<%= render("import_form", product_import: @product_import ) %>