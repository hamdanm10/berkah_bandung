<div class="flex items-center justify-between">
  <div class="flex gap-4 items-center">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: warehouse_admin_restock_invoices_path)) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <h2 class="text-xl font-bold text-gray-700">Invoice Details</h2>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: warehouse_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: warehouse_admin_restock_invoices_path, name: "Invoices")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Invoice Details", last: true)) %>
    <% end %>
  </div>
</div>
<%= render "invoice_details", invoice: @invoice %>