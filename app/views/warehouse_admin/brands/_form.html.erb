<%= form_with model: brand, 
    url: url,
    class: "mt-5 flex flex-col gap-5" do |form| %>
  <div class="block bg-white border border-gray-300 rounded-md divide-y divide-gray-300">
    <div class="p-4 lg:p-6">
      <h3 class="font-medium text-gray-700">Brand Form</h3>
      <p class="text-sm text-gray-500"><%= form_caption("brand", brand) %></p>
    </div>
    <div class="p-4 lg:p-6 flex flex-col gap-3">
      <div>
        <%= render(LabelInputComponent.new(form: form, field_name: :name, label: "Brand Name", required: true)) %>
        <%= render(TextInputComponent.new(form: form, field_name: :name, class: "mt-2")) %>
        <%= render(ErrorInputComponent.new(model: brand, field_name: :name)) %>
      </div>
    </div>
  </div>
  <div class="flex items-center justify-end">
    <%= render(ButtonComponent.new(type: "submit", size: "sm", variant: "primary")) do %>
      <%= lucide_icon("save", class: "size-5") %>
      <span>Save</span>
    <% end %>
  </div>
<% end %>