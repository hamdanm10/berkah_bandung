<div class="flex items-center justify-between">
  <div class="flex gap-4">
    <div class="flex flex-col justify-center">
      <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: order_supervisor_merchant_orders_path)) do %>
        <%= lucide_icon("chevron-left", class: "size-5") %>
      <% end %>
    </div>
    <div>
      <h2 class="text-xl font-bold text-gray-700">Order Batches</h2>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-xs px-2 py-1 bg-primary-soft border border-primary text-primary rounded-md text-center">
          <%= @merchant.marketplace.titleize %>
        </span>
        <span class="text-sm text-gray-700"><%= @merchant.name.titleize %></span>
      </div>
    </div>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: order_supervisor_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: order_supervisor_merchant_orders_path, name: "Merchant Orders")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Order Batches", last: true)) %>
    <% end %>
  </div>
</div>
<%= render("order_batches_list", merchant: @merchant, order_batches: @order_batches, pagy: @pagy, q: @q) %>