<%= turbo_frame_tag "return_section" do %>
  <%= form_with url: return_admin_returned_orders_path,
        scope: :return_order_form,
        class: "mt-5 flex flex-col gap-5" do |form| %>
    <%= form.hidden_field :order_id, value: order.id %>
    <div class="block bg-white border border-gray-300 rounded-md divide-y divide-gray-300">
      <div class="p-4 lg:p-6">
        <h3 class="text-gray-700">Return Order: <span class="font-medium"><%= order.order_number %></span></h3>
      </div>
      <% order.order_items.each do |item| %>
        <div class="p-4 lg:p-6 flex flex-col gap-3">
          <div>
            <p class="text-gray-800 text-sm font-medium"><%= item.product.name %> | Variant: <%= item.variant? ? item.variant : "-" %> | Qty: <%= item.quantity %></p>
            <%= render(LabelInputComponent.new(
                form: form,
                field_name: "return_order_form[items][#{item.id}][good_stock]",
                label: "Good Stock",
                required: true
              )) %>
            <%= number_field_tag(
                "return_order_form[items][#{item.id}][good_stock]",
                return_form.good_stock_for(item.id),
                min: 0,
                max: item.quantity,
                class: "mt-2 block w-full rounded-md border-gray-300") %>
            <% if (error = return_form.error_for(item.id)) %>
              <span class="text-sm text-red-500">
                <%= error %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="flex items-center justify-end">
      <%= render(ButtonComponent.new(type: "submit", size: "sm", variant: "primary")) do %>
        <%= lucide_icon("save", class: "size-5") %>
        <span>Submit</span>
      <% end %>
    </div>
  <% end %>
<% end %>