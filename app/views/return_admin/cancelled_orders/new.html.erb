<div class="flex items-center justify-between">
  <div class="flex gap-4 items-center">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: return_admin_cancelled_orders_path)) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <h2 class="text-xl font-bold text-gray-700">Scan to Cancel</h2>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: return_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: return_admin_cancelled_orders_path, name: "Cancelled Orders")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Scan to Cancel", last: true)) %>
    <% end %>
  </div>
</div>
<%= render("form", url: return_admin_cancelled_orders_path, scan_order: @scan_order) %>
<turbo-frame id="scan_alert"></turbo-frame>
<turbo-frame id="scan_results">
  <div class="mt-6 flex flex-col gap-4"></div>
</turbo-frame>