<tr class="bg-white last:border-b-0 hover:bg-gray-50 border-b border-b-gray-300" data-controller="global-dialog-trigger">
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= pagy.offset + index + 1 %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= order.order_number %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= order.tracking_number %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= order.courier_service.name %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= order.total_items %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <% case order.status %>
    <% when "preparing" %>
      <span class="text-xs px-2 py-1 bg-secondary-soft border border-secondary text-secondary rounded-md">Preparing</span>
    <% when "delivered" %>
      <span class="text-xs px-2 py-1 bg-primary-soft border border-primary text-primary rounded-md">Delivered</span>
    <% when "cancelled" %>
      <span class="text-xs px-2 py-1 bg-danger-soft border border-danger text-danger rounded-md">Cancelled</span>
    <% when "returned" %>
      <span class="text-xs px-2 py-1 bg-warning-soft border border-warning text-warning rounded-md">Returned</span>
    <% when "paid" %>
      <span class="text-xs px-2 py-1 bg-success-soft border border-success text-success rounded-md">Paid</span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_datetime(order.created_at) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700 flex gap-2 items-center">
    <%= link_to order_admin_merchant_order_order_batch_order_path(merchant, order_batch, order), 
      class: "text-info hover:text-info-hover", 
      "data-hint": "Detail", 
      "data-action": "mouseenter->hint#show mouseleave->hint#hide" do %>
      <%= lucide_icon("info", class: "size-5") %>
    <% end %>
    <% if order.preparing? %>
      <%= link_to edit_order_admin_merchant_order_order_batch_order_path(merchant, order_batch, order), 
        class: "text-secondary hover:text-secondary-hover", 
        "data-hint": "Edit", 
        "data-action": "mouseenter->hint#show mouseleave->hint#hide" do %>
        <%= lucide_icon("pencil", class: "size-5") %>
      <% end %>
      <button
        type="button"
        class="text-danger hover:text-danger-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Delete"
        data-confirm-dialog-title="Delete Order"
        data-confirm-dialog-message="Are you sure you want to delete this order '<%= order.order_number %>'?"
        data-confirm-dialog-url="<%= order_admin_merchant_order_order_batch_order_path(merchant, order_batch, order) %>"
        data-confirm-dialog-method="delete"
        data-confirm-dialog-variant="danger"
        data-confirm-dialog-label="Delete">
        <%= lucide_icon("trash-2", class: "size-5") %>
      </button>
    <% end %>
  </td>
</tr>