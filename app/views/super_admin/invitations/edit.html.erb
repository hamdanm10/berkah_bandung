<div class="flex items-center justify-between">
  <div class="flex gap-4 items-center">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: super_admin_invitations_path)) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <h2 class="text-xl font-bold text-gray-700">Edit invitation</h2>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_invitations_path, name: "Invitations")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Edit Invitation", last: true)) %>
    <% end %>
  </div>
</div>
<%= render "form", url: super_admin_invitation_path(@invitation), invitation: @invitation %>