<%= form_with model: invitation, 
    url: url, 
    data: {
      controller: "choices-select",
    },
    class: "mt-5 flex flex-col gap-5" do |form| %>
  <div class="block bg-white border border-gray-300 rounded-lg divide-y divide-gray-300">
    <div class="p-4 lg:p-6">
      <h3 class="font-medium text-gray-700">Invitation Form</h3>
      <p class="text-sm text-gray-500"><%= form_caption("invitation", invitation) %></p>
    </div>
    <div class="p-4 lg:p-6 flex flex-col gap-3">
      <div>
        <%= render(Ui::LabelInputComponent.new(form: form, field_name: :assigned_role, label: "Assigned Role", required: true)) %>
        <%= render(
            DropdownSearchInputComponent.new(
            form: form,
            field_name: :assigned_role,
            records: assigned_roles_for_select,
            current_value: invitation.assigned_role,
            prompt: "Choose assigned role",
            class: "mt-2"
          )
        ) %>
        <%= render(ErrorInputComponent.new(model: invitation, field_name: :assigned_role)) %>
      </div>
    </div>
  </div>
  <div class="flex items-center justify-end">
    <%= render(Ui::ButtonComponent.new(type: "submit", size: "sm", variant: "primary")) do %>
      <%= lucide_icon("save", class: "size-5") %>
      <span>Save</span>
    <% end %>
  </div>
<% end %>