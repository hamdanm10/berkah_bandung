<tr class="bg-white last:border-b-0 hover:bg-gray-50 border-b border-b-gray-300">
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= pagy.offset + index + 1 %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invitation.invitation_code %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_datetime(invitation.expires_at) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invitation.assigned_role.titleize %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <% case invitation.status %>
    <% when :active %>
      <span class="text-xs px-2 py-1 bg-success-soft border border-success text-success rounded-md">Active</span>
    <% when :used %>
      <span class="text-xs px-2 py-1 bg-warning-soft border border-warning text-warning rounded-md">Used</span>
    <% when :expired %>
      <span class="text-xs px-2 py-1 bg-danger-soft border border-danger text-danger rounded-md">Expired</span>
    <% end %>
  </td>
</tr>