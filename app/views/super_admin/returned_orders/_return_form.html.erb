<%= turbo_frame_tag "return_section" do %>
  <%= form_with url: super_admin_returned_orders_path, class: "mt-5 flex flex-col gap-5" do |form| %>
    <%= hidden_field_tag :order_id, order.id %>
    <div class="block bg-white border border-gray-300 rounded-md divide-y divide-gray-300">
      <div class="p-4 lg:p-6">
        <h3 class="text-gray-700">Return Order: <span class="font-medium"><%= order.order_number %></span></h3>
      </div>
      <% order.order_items.each do |item| %>
        <div class="p-4 lg:p-6 flex flex-col gap-3">
          <div>
            <p class="text-gray-800 text-sm font-medium"><%= item.product.name %> (Variant: <%= item.variant? ? item.variant : "-" %>)</p>
            <%= render(LabelInputComponent.new(
                form: form,
                field_name: "items[#{item.id}][good_stock]",
                label: "Good Stock (Qty: #{item.quantity})",
                required: true
              )) %>
            <%= number_field_tag "items[#{item.id}][good_stock]",
                nil,
                min: 0,
                max: item.quantity,
                class: "mt-2 block w-full rounded-md border-gray-300" %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="flex items-center justify-end">
      <%= render(ButtonComponent.new(type: "submit", size: "sm", variant: "primary")) do %>
        <%= lucide_icon("save", class: "size-5") %>
        <span>Submit</span>
      <% end %>
    </div>
  <% end %>
<% end %>