<tr class="bg-white last:border-b-0 hover:bg-gray-50 border-b border-b-gray-300" data-controller="global-dialog-trigger">
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= pagy.offset + index + 1 %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= user.full_name.titleize %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= user.username %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= user.role.titleize %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <% if user.is_active? %>
      <span class="text-xs px-2 py-1 bg-success-soft border border-success text-success rounded-md">
        Active
      </span>
    <% else %>
      <span class="text-xs px-2 py-1 bg-danger-soft border border-danger text-danger rounded-md">
        Inactive
      </span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700 flex gap-2 items-center">
    <% if user.is_active? %>
      <button
        type="button"
        class="text-danger hover:text-danger-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Deactivate"
        data-confirm-dialog-title="Deactivate User"
        data-confirm-dialog-message="Are you sure you want to deactivate this user '<%= user.full_name %>'?"
        data-confirm-dialog-url="<%= deactivate_super_admin_user_path(user) %>"
        data-confirm-dialog-method="patch"
        data-confirm-dialog-variant="danger"
        data-confirm-dialog-label="Deactivate">
        <%= lucide_icon("ban", class: "size-5") %>
      </button>
    <% else %>
      <button
        type="button"
        class="text-success hover:text-success-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Activate"
        data-confirm-dialog-title="Activate User"
        data-confirm-dialog-message="Are you sure you want to activate this user '<%= user.full_name %>'?"
        data-confirm-dialog-url="<%= activate_super_admin_user_path(user) %>"
        data-confirm-dialog-method="patch"
        data-confirm-dialog-variant="primary"
        data-confirm-dialog-label="Activate">
        <%= lucide_icon("check", class: "size-5") %>
      </button>
    <% end %>
    <button
      type="button"
      class="text-secondary hover:text-secondary-hover cursor-pointer"
      data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
      data-hint= "Reset Password"
      data-confirm-dialog-title="Reset Password"
      data-confirm-dialog-message="Are you sure you want to reset Hamdan’s password to 'BerkahBandung'?"
      data-confirm-dialog-url="<%= reset_password_super_admin_user_path(user) %>"
      data-confirm-dialog-method="patch"
      data-confirm-dialog-variant="secondary"
      data-confirm-dialog-label="Reset Password">
      <%= lucide_icon("key-round", class: "size-5") %>
    </button>
  </td>
</tr>