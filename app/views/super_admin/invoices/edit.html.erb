<div class="flex items-center justify-between">
  <div class="flex gap-4 items-center">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: super_admin_invoices_path)) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <div class="flex items-center gap-4">
      <h2 class="text-xl font-bold text-gray-700">Edit Invoice</h2>
      <span>-</span>
      <% if @invoice.invoice_status == "draft"%>
        <span class="text-sm px-4 py-1 bg-warning-soft border border-warning text-warning rounded-md">Draft</span>
      <% elsif @invoice.invoice_status == "posted" %>
        <span class="text-sm px-4 py-1 bg-primary-soft border border-primary text-primary rounded-md">Posted</span>
      <% end %>
    </div>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_invoices_path, name: "Invoices")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Edit Invoice", last: true)) %>
    <% end %>
  </div>
</div>
<%= render "form", url: super_admin_invoice_path(@invoice), invoice: @invoice %>