<tr class="<%= invoice.remarks.present? ? "bg-warning-soft" : "bg-white hover:bg-gray-50" %> last:border-b-0 border-b border-b-gray-300" data-controller="global-dialog-trigger">
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= pagy.offset + index + 1 %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invoice.invoice_number %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invoice.invoice %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invoice.distributor.name %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invoice.reference_invoice&.invoice_number %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_price(invoice.invoice_amount) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_price(invoice.entered_amount) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_price(invoice.transfer_amount) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_price(invoice.total_transfer_amount) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_date(invoice.received_date) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_date(invoice.transfer_date) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <% case invoice.invoice_status %>
    <% when "draft" %>
      <span class="text-xs px-2 py-1 bg-warning-soft border border-warning text-warning rounded-md">Draft</span>
    <% when "posted" %>
      <span class="text-xs px-2 py-1 bg-primary-soft border border-primary text-primary rounded-md">Posted</span>
    <% when "paid" %>
      <span class="text-xs px-2 py-1 bg-success-soft border border-success text-success rounded-md">Paid</span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <% case invoice.invoice_type %>
    <% when "normal" %>
      <span class="text-xs px-2 py-1 bg-primary-soft border border-primary text-primary rounded-md">Normal</span>
    <% when "return" %>
      <span class="text-xs px-2 py-1 bg-danger-soft border border-danger text-danger rounded-md">Return</span>
    <% when "adjustment" %>
      <span class="text-xs px-2 py-1 bg-warning-soft border border-warning text-warning rounded-md">Adjustment</span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= invoice.user_created.username %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= format_datetime(invoice.created_at) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700 flex gap-2 items-center">
    <% if invoice.draft? %>
      <button
        type="button"
        class="text-primary hover:text-primary-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Post"
        data-confirm-dialog-title="Post Invoice"
        data-confirm-dialog-message="Are you sure you want to post this invoice '<%= invoice.invoice_number %>'?"
        data-confirm-dialog-url="<%= post_super_admin_invoice_path(invoice) %>"
        data-confirm-dialog-method="patch"
        data-confirm-dialog-variant="primary"
        data-confirm-dialog-label="Post">
        <%= lucide_icon("send", class: "size-5") %>
      </button>
    <% elsif invoice.posted? %>
      <button
        type="button"
        class="text-success hover:text-success-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Mark as Paid"
        data-confirm-dialog-title="Mark as Paid Invoice"
        data-confirm-dialog-message="Are you sure you want to mark this invoice '<%= invoice.invoice_number %>' as paid? Note: The remarks will be cleared."
        data-confirm-dialog-url="<%= mark_as_paid_super_admin_invoice_path(invoice) %>"
        data-confirm-dialog-method="patch"
        data-confirm-dialog-variant="success"
        data-confirm-dialog-label="Mark as Paid">
        <%= lucide_icon("circle-check", class: "size-5") %>
      </button>
    <% end %>
    <%= link_to super_admin_invoice_path(invoice), 
        class: "text-info hover:text-info-hover", 
        "data-hint": "Detail", 
        "data-action": "mouseenter->hint#show mouseleave->hint#hide" do %>
      <%= lucide_icon("info", class: "size-5") %>
    <% end %>
    <% if invoice.invoice_status != "paid" %>
      <%= link_to edit_super_admin_invoice_path(invoice),
        class: "text-secondary hover:text-secondary-hover",
        data: {
          hint: "Edit",
          action: "mouseenter->hint#show mouseleave->hint#hide"
        } do %>
        <%= lucide_icon("pencil", class: "size-5") %>
      <% end %>
    <% end %>
    <% if invoice.draft? %>
      <button
        type="button"
        class="text-danger hover:text-danger-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Delete"
        data-confirm-dialog-title="Delete Invoice"
        data-confirm-dialog-message="Are you sure you want to delete this invoice '<%= invoice.invoice_number %>'?"
        data-confirm-dialog-url="<%= super_admin_invoice_path(invoice) %>"
        data-confirm-dialog-method="delete"
        data-confirm-dialog-variant="danger"
        data-confirm-dialog-label="Delete">
        <%= lucide_icon("trash-2", class: "size-5") %>
      </button>
    <% end %>
  </td>
</tr>
