<tr class="bg-white last:border-b-0 hover:bg-gray-50 border-b border-b-gray-300" data-controller="global-dialog-trigger">
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= pagy.offset + index + 1 %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= product.code.upcase %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= product.barcode %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= product.name %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= product.category.name.titleize %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= product.brand.name %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <%= product.total_quantity %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <% if product.is_active? %>
      <span class="text-xs px-2 py-1 bg-success-soft border border-success text-success rounded-md">
        Active
      </span>
    <% else %>
      <span class="text-xs px-2 py-1 bg-danger-soft border border-danger text-danger rounded-md">
        Inactive
      </span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700">
    <div class="flex justify-center">
      <%= link_to super_admin_product_stock_adjustments_path(product), 
        class: "text-secondary hover:text-secondary-hover", 
        "data-hint": "Stock Adjustment", 
        "data-action": "mouseenter->hint#show mouseleave->hint#hide" do %>
        <%= lucide_icon("settings", class: "size-5") %>
      <% end %>
    </div>
  </td>
  <td class="px-6 py-4 whitespace-nowrap font-normal text-gray-700 flex gap-2 items-center">
    <%= link_to super_admin_product_path(product), 
        class: "text-info hover:text-info-hover", 
        "data-hint": "Detail", 
        "data-action": "mouseenter->hint#show mouseleave->hint#hide" do %>
      <%= lucide_icon("info", class: "size-5") %>
    <% end %>
    <%= link_to edit_super_admin_product_path(product), 
        class: "text-secondary hover:text-secondary-hover", 
        "data-hint": "Edit", 
        "data-action": "mouseenter->hint#show mouseleave->hint#hide" do %>
      <%= lucide_icon("pencil", class: "size-5") %>
    <% end %>
    <% if product.is_active? %>
      <button
        type="button"
        class="text-danger hover:text-danger-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Deactivate"
        data-confirm-dialog-title="Deactivate Product"
        data-confirm-dialog-message="Are you sure you want to deactivate this product '<%= product.name %>'?"
        data-confirm-dialog-url="<%= deactivate_super_admin_product_path(product) %>"
        data-confirm-dialog-method="patch"
        data-confirm-dialog-variant="danger"
        data-confirm-dialog-label="Deactivate">
        <%= lucide_icon("ban", class: "size-5") %>
      </button>
    <% else %>
      <button
        type="button"
        class="text-success hover:text-success-hover cursor-pointer"
        data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
        data-hint= "Activate"
        data-confirm-dialog-title="Activate Product"
        data-confirm-dialog-message="Are you sure you want to activate this product '<%= product.name %>'?"
        data-confirm-dialog-url="<%= activate_super_admin_product_path(product) %>"
        data-confirm-dialog-method="patch"
        data-confirm-dialog-variant="primary"
        data-confirm-dialog-label="Activate">
        <%= lucide_icon("check", class: "size-5") %>
      </button>
    <% end %>
    <button
      type="button"
      class="text-danger hover:text-danger-hover cursor-pointer"
      data-action="click->confirm-dialog#open mouseenter->hint#show mouseleave->hint#hide"
      data-hint= "Delete"
      data-confirm-dialog-title="Delete Product"
      data-confirm-dialog-message="Are you sure you want to delete this product '<%= product.name %>'?"
      data-confirm-dialog-url="<%= super_admin_product_path(product) %>"
      data-confirm-dialog-method="delete"
      data-confirm-dialog-variant="danger"
      data-confirm-dialog-label="Delete">
      <%= lucide_icon("trash-2", class: "size-5") %>
    </button>
  </td>
</tr>