<div
  class="w-full bg-white border max-w-none border-gray-300 mt-5 flex flex-col divide-y divide-gray-300 rounded-md shadow-none"
  data-controller="filter hint confirm-dialog"
  data-filter-initial-open-value="<%= params[:q].present? %>"
>
  <div class="flex flex-col p-4 gap-4 lg:flex-row lg:items-center lg:justify-between lg:p-6 lg:gap-0">
    <%= render(RecordLimitComponent.new) %>
    <div class="flex lg:items-center gap-3">
      <div>
        <%= render(
              ButtonComponent.new(
                type: "button",
                size: "sm",
                variant: "light",
                "data-hint": "Filter",
                "data-action": "
                  mouseenter->hint#show
                  mouseleave->hint#hide
                  click->filter#toggle
                "
              )
            ) do %>
          <%= lucide_icon("settings-2", class: "size-5") %>
        <% end %>
      </div>
      <div class="flex">
        <%= render(ButtonLinkComponent.new(
              size: "sm", 
              variant: "primary", 
              url: new_super_admin_merchant_path,
              "data-hint": "Add",
              "data-action": "
                mouseenter->hint#show
                mouseleave->hint#hide
              "
            )) do %>
          <%= lucide_icon("plus", class: "size-5") %>
        <% end %>
      </div>
    </div>
  </div>
  <div 
    data-filter-target="panel" 
    class="overflow-hidden h-0 opacity-0 transition-[height,opacity] duration-200 ease-out"
  >
    <div class="flex justify-end gap-3 p-6">
      <%= render FilterComponent.new(
            q: q,
            url: super_admin_merchants_path,
            show_submit: true,
            fields: [
              {
                type: :select,
                name: :is_active_eq,
                records: merchant_statuses_for_select,
                blank: "All Statuses",
                auto_submit: false
              },
              {
                type: :search,
                name: :name_or_marketplace_cont,
                placeholder: "Search...",
                auto_submit: false
              }
            ]
          ) %>
    </div>
  </div>
  <div class="overflow-x-auto">
    <div class="relative overflow-x-auto">
      <table class="w-full text-left text-xs lg:text-sm text-gray-500">
        <thead class="text-xs uppercase text-gray-700 border-b border-b-gray-300 bg-white">
          <tr>
            <th class="px-6 py-3 font-medium normal-case">#</th>
            <th class="px-6 py-3 font-medium normal-case">Merchant Name</th>
            <th class="px-6 py-3 font-medium normal-case">Marketplace</th>
            <th class="px-6 py-3 font-medium normal-case">Status</th>
            <th class="px-6 py-3 font-medium normal-case">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if merchants.any? %>
            <% merchants.each_with_index do |merchant, index| %>
              <%= render("merchant", merchant: merchant, index: index, pagy: pagy) %>
            <% end %>
          <% else %>
            <td colspan="100%" class="px-6 py-4 text-center text-gray-700">
              No data found.
            </td>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render(PaginationComponent.new(records: merchants, pagy: pagy)) %>
  <%= render(HintComponent.new) %>
  <%= render(ConfirmDialogComponent.new) %>
</div>