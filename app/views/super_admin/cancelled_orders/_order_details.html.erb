<div class="mt-5 flex flex-col gap-5">
  <div class="block bg-white border border-gray-300 rounded-md divide-y divide-gray-300">
    <div class="p-4 lg:p-6">
      <h3 class="font-medium text-gray-700">Order Details</h3>
      <p class="text-sm text-gray-500">Below are the details of the order.</p>
    </div>
    <div class="px-4 lg:px-6 text-gray-700 flex flex-col text-sm">
      <div class="flex gap-2 pt-4 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Merchant Name</span>
        </div>
        <div class="w-10/12">
          <span><%= order.order_batch.merchant.name %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Marketplace</span>
        </div>
        <div class="w-10/12">
          <span><%= order.order_batch.merchant.marketplace %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Order Batch</span>
        </div>
        <div class="w-10/12">
          <span><%= order.order_batch.code %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Order Number</span>
        </div>
        <div class="w-10/12">
          <span><%= order.order_number %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Tracking Number</span>
        </div>
        <div class="w-10/12">
          <span><%= order.tracking_number %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Courier Service</span>
        </div>
        <div class="w-10/12">
          <span><%= order.courier_service.name %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Total Items</span>
        </div>
        <div class="w-10/12">
          <span><%= order.total_items %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Status</span>
        </div>
        <div class="w-10/12">
          <% case order.status %>
          <% when "preparing" %>
            <span class="text-xs px-2 py-1 bg-secondary-soft border border-secondary text-secondary rounded-md">Preparing</span>
          <% when "delivered" %>
            <span class="text-xs px-2 py-1 bg-primary-soft border border-primary text-primary rounded-md">Delivered</span>
          <% when "cancelled" %>
            <span class="text-xs px-2 py-1 bg-danger-soft border border-danger text-danger rounded-md">Cancelled</span>
          <% when "returned" %>
            <span class="text-xs px-2 py-1 bg-warning-soft border border-warning text-warning rounded-md">Returned</span>
          <% when "paid" %>
            <span class="text-xs px-2 py-1 bg-success-soft border border-success text-success rounded-md">Paid</span>
          <% end %>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-2">
        <div class="w-2/12">
          <span class="font-medium">Cancelled By</span>
        </div>
        <div class="w-10/12">
          <span><%= order.cancelled_by.full_name %></span>
        </div>
      </div>
      <div class="flex gap-2 pt-2 pb-4">
        <div class="w-2/12">
          <span class="font-medium">Cancelled At</span>
        </div>
        <div class="w-10/12">
          <span><%= format_datetime(order.cancelled_at) %></span>
        </div>
      </div>
    </div>
  </div>
  <div class="block bg-white border border-gray-300 rounded-md divide-y divide-gray-300">
    <div class="p-4 lg:p-6">
      <h3 class="font-medium text-gray-700">Order Items Details</h3>
      <p class="text-sm text-gray-500">Below are the details of the order item.</p>
    </div>
    <% order.order_items.each do |order_item| %>
      <div class="px-4 lg:px-6 text-gray-700 flex flex-col text-sm">
        <div class="flex gap-2 pt-4 pb-2">
          <div class="w-2/12">
            <span class="font-medium">Product Code</span>
          </div>
          <div class="w-10/12">
            <span><%= order_item.product_code %></span>
          </div>
        </div>
        <div class="flex gap-2 pt-2 pb-2">
          <div class="w-2/12">
            <span class="font-medium">Product Name</span>
          </div>
          <div class="w-10/12">
            <span><%= order_item.product_name %></span>
          </div>
        </div>
        <div class="flex gap-2 pt-2 pb-2">
          <div class="w-2/12">
            <span class="font-medium">Variant</span>
          </div>
          <div class="w-10/12">
            <span><%= order_item.variant? ? order_item.variant : "-" %></span>
          </div>
        </div>
        <div class="flex gap-2 pt-2 pb-4">
          <div class="w-2/12">
            <span class="font-medium">Quantiy</span>
          </div>
          <div class="w-10/12">
            <span><%= order_item.quantity %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>