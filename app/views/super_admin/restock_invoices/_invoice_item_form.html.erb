<div class="p-4 lg:p-6 flex flex-col gap-3 nested-form-wrapper border-b border-gray-300" data-new-record="<%= form.object.new_record? %>">
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :distributor_id, label: "Product", required: true)) %>
    <%= render(DropdownSearchInputComponent.new(
        form: form,
        field_name: :product_id,
        search_url: search_super_admin_products_path,
        current_value: form.object.product_id,
        current_label: form.object.product&.name,
        prompt: "Choose product",
        class: "mt-2"
      )
    ) %>
    <%= render(ErrorInputComponent.new(model: form.object, field_name: :product_id)) %>
  </div>
  <div data-invoice-type-target="adjustmentItem" class="<%= @invoice.adjustment? ? '' : 'hidden' %>">
    <%= render(
      LabelInputComponent.new(
        form: form,
        field_name: :adjustment_type,
        label: "Stock Adjustment",
        required: true
      )
    ) %>
    <div class="mt-2 flex gap-6 text-sm">
      <label class="flex items-center gap-2 cursor-pointer">
        <%= form.radio_button :adjustment_type, "increase" %>
        <span class="text-success">Increase (+)</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= form.radio_button :adjustment_type, "decrease" %>
        <span class="text-danger">Decrease (-)</span>
      </label>
    </div>
    <%= render(
      ErrorInputComponent.new(
        model: form.object,
        field_name: :adjustment_type
      )
    ) %>
  </div>
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :quantity, label: "Quantity", required: true)) %>
    <%= render(NumberInputComponent.new(form: form, field_name: :quantity, class: "mt-2")) %>
    <%= render(ErrorInputComponent.new(model: form.object, field_name: :quantity)) %>
  </div>
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :cost_snapshot, label: "Cost Price", required: true)) %>
    <%= render(CurrencyInputComponent.new(form: form, field_name: :cost_snapshot, class: "mt-2")) %>
    <%= render(ErrorInputComponent.new(model: form.object, field_name: :cost_snapshot)) %>
  </div>
  <% if removable %>
    <div class="flex justify-end mt-2">
      <%= render(ButtonComponent.new(type: "button", size: "sm", variant: "danger", "data-action": "nested-form#remove")) do %>
        <%= lucide_icon("trash-2", class: "size-5") %>
      <% end %>
    </div>
  <% end %>
  <%= form.hidden_field :_destroy %>
</div>
