<div class="flex gap-0 items-center justify-between">
  <div class="flex items-center gap-4">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: super_admin_product_stock_adjustments_path(@product))) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <h2 class="text-xl font-bold text-gray-700">New Product Available</h2>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_products_path, name: "Products")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_product_stock_adjustments_path(@product), name: "Stock Adjustments")) %>
      <%= render(BreadcrumbItemComponent.new(name: "New Product Available", last: true)) %>
    <% end %>
  </div>
</div>
<%= render("form", url: super_admin_product_stock_adjustments_path(@product), product_available: @product_available, product: @product) %>