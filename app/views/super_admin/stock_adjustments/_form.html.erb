<%= form_with model: product_available, 
    url: url,
    class: "mt-5 flex flex-col gap-5" do |form| %>
  <div class="block bg-white border border-gray-300 rounded-md divide-y divide-gray-300">
    <div class="p-4 lg:p-6">
      <h3 class="font-medium text-gray-700">Product Available Form</h3>
      <p class="text-sm text-gray-500"><%= form_caption("product available", product_available) %></p>
    </div>
    <div class="p-4 lg:p-6 flex flex-col gap-3">
      <div>
        <%= render(LabelInputComponent.new(form: form, field_name: :cost_price, label: "Cost Price", required: true)) %>
        <%= render(CurrencyInputComponent.new(form: form, field_name: :cost_price, class: "mt-2")) %>
        <%= render(ErrorInputComponent.new(model: product_available, field_name: :cost_price)) %>
      </div>
      <div>
        <%= render(LabelInputComponent.new(form: form, field_name: :quantity, label: "Quantity", required: true)) %>
        <%= render(NumberInputComponent.new(form: form, field_name: :quantity, class: "mt-2")) %>
        <%= render(ErrorInputComponent.new(model: product_available, field_name: :quantity)) %>
      </div>
    </div>
  </div>
  <div class="flex items-center justify-end">
    <%= render(ButtonComponent.new(type: "submit", size: "sm", variant: "primary")) do %>
      <%= lucide_icon("save", class: "size-5") %>
      <span>Save</span>
    <% end %>
  </div>
<% end %>