<div class="flex gap-0 items-center justify-between">
  <h2 class="text-xl font-bold text-gray-700">Brands</h2>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Brands", last: true)) %>
    <% end %>
  </div>
</div>
<%= render("brands_list", brands: @brands, pagy: @pagy, q: @q) %>