<div class="flex items-center justify-between">
  <div class="flex gap-4 items-center">
    <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: super_admin_courier_services_path)) do %>
      <%= lucide_icon("chevron-left", class: "size-5") %>
    <% end %>
    <h2 class="text-xl font-bold text-gray-700">Edit Courier Service</h2>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_courier_services_path, name: "Courier Services")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Edit Courier Service", last: true)) %>
    <% end %>
  </div>
</div>
<%= render "form", url: super_admin_courier_service_path(@courier_service), courier_service: @courier_service %>