<div class="flex items-center justify-between">
  <div class="flex gap-4">
    <div class="flex flex-col justify-center">
      <%= render(ButtonLinkComponent.new(size: "sm", variant: "light", url: super_admin_merchant_order_order_batches_path(@merchant))) do %>
        <%= lucide_icon("chevron-left", class: "size-5") %>
      <% end %>
    </div>
    <div>
      <h2 class="text-xl font-bold text-gray-700">Orders</h2>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-xs px-2 py-1 bg-primary-soft border border-primary text-primary rounded-md text-center">
          <%= @merchant.marketplace.titleize %>
        </span>
        <span class="text-sm text-gray-700"><%= @merchant.name.titleize %></span>
        <span class="text-sm text-gray-700">|</span>
        <span class="text-sm text-gray-700">Batch: <%= @order_batch.code %></span>
        <span class="text-sm text-gray-700">|</span>
        <span class="text-sm text-gray-700"><%= format_datetime(@order_batch.created_at) %></span>
        <span class="text-sm text-gray-700">|</span>
        <div class="flex items-center gap-1">
          <span class="text-sm text-gray-700">Created By:</span>
          <span class="inline-block text-sm text-gray-700 w-[16ch] truncate"><%= @order_batch.user_created.full_name %></span>
        </div>
      </div>
    </div>
  </div>
  <div class="hidden lg:block">
    <%= render(BreadcrumbComponent.new) do %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_dashboard_path, icon: "layout-grid", name: "Dashboard")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_merchant_orders_path, name: "Merchant Orders")) %>
      <%= render(BreadcrumbItemComponent.new(url: super_admin_merchant_order_order_batches_path(@merchant), name: "Order Batches")) %>
      <%= render(BreadcrumbItemComponent.new(name: "Orders", last: true)) %>
    <% end %>
  </div>
</div>
<%= render("orders_list", merchant: @merchant, order_batch: @order_batch, orders: @orders, pagy: @pagy, q: @q) %>
