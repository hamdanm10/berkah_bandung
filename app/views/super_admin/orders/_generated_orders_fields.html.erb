<% @form.build_orders %>
<% @form.orders.each_with_index do |order_data, i| %>
  <div class="p-4 lg:p-6 flex flex-col gap-3 border-b border-b-gray-300">
    <!-- Order Number -->
    <div>
      <%= render(LabelInputComponent.new(
        form: form,
        field_name: "orders[#{i}][order_number]",
        label: "Order Number",
        required: true
      )) %>
      <%= text_field_tag(
        "orders[#{i}][order_number]",
        order_data.order_number,
        class: "mt-2 block w-full rounded-md border-gray-300", 
        autofocus: (@form.orders.present? && i.zero?),
        data: { scan_target: "orderNumber" }
      ) %>
      <%= render(ErrorInputComponent.new(
        model: order_data,
        field_name: :order_number
      )) %>
    </div>
    <!-- Tracking Number -->
    <div>
      <%= render(LabelInputComponent.new(
        form: form,
        field_name: "orders[#{i}][tracking_number]",
        label: "Tracking Number",
        required: true
      )) %>
      <%= text_field_tag(
        "orders[#{i}][tracking_number]",
        order_data.tracking_number,
        class: "mt-2 block w-full rounded-md border-gray-300",
        data: { scan_target: "trackingNumber" }
      ) %>
      <%= render(ErrorInputComponent.new(
        model: order_data,
        field_name: :tracking_number
      )) %>
    </div>
  </div>
<% end %>
