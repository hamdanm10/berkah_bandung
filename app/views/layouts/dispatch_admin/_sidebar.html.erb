<%
  dashboard_modules = [
    { icon: "layout-grid", url: dispatch_admin_dashboard_path, name: "Dashboard" },
  ]

  order_modules = [
    { icon: "package", url: dispatch_admin_delivered_orders_path, name: "Delivered Orders" },
  ]
%>
<%= render(SidebarComponent.new(sidebar_id: "super-admin-sidebar")) do %>
  <!-- Dashboard -->
  <li>
    <div class="px-2 text-xs text-gray-500 uppercase">Dashboard</div>
  </li>
  <% dashboard_modules.each do |item| %>
    <%= render(SidebarLinkComponent.new(icon: item[:icon], url: item[:url], name: item[:name])) %>
  <% end %>
  <!-- Order Module -->
  <li>
    <div class="px-2 text-xs text-gray-500 uppercase pt-2.5">Order Module</div>
  </li>
  <% order_modules.each do |item| %>
    <%= render(SidebarLinkComponent.new(icon: item[:icon], url: item[:url], name: item[:name])) %>
  <% end %>
<% end %>
