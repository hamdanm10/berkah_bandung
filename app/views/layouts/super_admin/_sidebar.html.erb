<%
  main_modules = [
    { icon: "layout-grid", url: super_admin_dashboard_path, name: "Dashboard" },
  ]

  master_modules = [
    { icon: "mail", url: super_admin_invitations_path, name: "Invitation" },
    { icon: "user-round", url: super_admin_users_path, name: "User" },
    { icon: "store", url: super_admin_merchants_path, name: "Merchant" },
    { icon: "van", url: super_admin_courier_services_path, name: "Courier Service" },
  ]
%>
<%= render(SidebarComponent.new(sidebar_id: "super-admin-sidebar")) do %>
  <li>
    <div class="px-2 text-xs text-gray-500 uppercase">Main</div>
  </li>
  <% main_modules.each do |main_module| %>
    <%= render(SidebarLinkComponent.new(
          icon: main_module[:icon],
          url: main_module[:url],
          name: main_module[:name]
        )) %>
  <% end %>
  <li>
    <div class="px-2 text-xs text-gray-500 uppercase pt-2.5">Master</div>
  </li>
  <% master_modules.each do |master_module| %>
    <%= render(SidebarLinkComponent.new(
        icon: master_module[:icon],
        url: master_module[:url],
        name: master_module[:name]
      )) %>
  <% end %>
<% end %>