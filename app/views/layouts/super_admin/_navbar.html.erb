<%= render(NavbarComponent.new) do %>
  <div class="flex items-center gap-2">
    <%= render(ButtonComponent.new(type: "button", size: "sm", variant: "light", "data-drawer-target": "super-admin-sidebar", "data-drawer-toggle": "super-admin-sidebar", "aria-controls": "super-admin-sidebar", class: "lg:hidden block")) do %>
      <span class="sr-only">Open sidebar</span>
      <%= lucide_icon("panel-right-close", class: "size-5") %>
    <% end %>
  </div>
  <div class="flex items-center md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse gap-2">
    <button
      type="button"
      class="border border-gray-300 py-2 px-2 shadow-sm rounded-md flex items-center text-sm gap-2 hover:cursor-pointer relative"
      id="notification-button"
      aria-expanded="false"
      data-dropdown-toggle="notification-dropdown"
      data-dropdown-placement="bottom"
    >
      <span class="sr-only">Open notification</span>
      <%= lucide_icon('bell', class: 'size-5') %>
      <% if @recent_notifications.any? %>
        <span class="absolute -top-1 -right-1 flex size-3">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex size-3 rounded-full bg-red-500"></span>
        </span>
      <% end %>
    </button>
    <%# Notification Dropdown %>
    <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-300 rounded-md shadow-sm w-xs border border-gray-300" id="notification-dropdown">
      <div class="px-4 py-3">
        <span class="block text-sm font-medium text-gray-800 truncate max-w-[30ch]">
          Notifications
        </span>
      </div>
      <ul>
        <% if @recent_notifications.any? %>
          <% @recent_notifications.each do |notification| %>
            <li>
              <div class="px-4 py-2 text-sm flex flex-col">
                <span class="font-medium text-gray-800"><%= notification.title %></span>
                <span class="block text-sm text-gray-600 truncate max-w-[30ch]">
                  <%= notification.message %>
                </span>
              </div>
            </li>
          <% end %>
        <% else %>
          <li>
            <span class="px-4 py-2 text-sm block text-gray-600">
              No notification found.
            </span>
          </li>
        <% end %>
      </ul>
      <div class="px-4 py-3">
        <%= link_to super_admin_notifications_path, class: "text-sm hover:underline font-medium text-gray-800 flex gap-2 items-center" do %>
          <span>See all notifications</span>
          <%= lucide_icon('move-right', class: 'size-3') %>
        <% end %>
      </div>
    </div>
    <button type="button" class="border border-gray-300  py-2 px-2 shadow-sm rounded-md flex items-center text-sm gap-2 hover:cursor-pointer" id="user-menu-button" aria-expanded="false" data-dropdown-toggle="user-dropdown" data-dropdown-placement="bottom">
      <span class="sr-only">Open user menu</span>
      <span class="hidden lg:block truncate max-w-[15ch] text-gray-800"><%= current_user.full_name %></span>
      <%= lucide_icon("chevron-down", class: "size-5 hidden lg:block") %>
    </button>
    <!-- Dropdown menu -->
    <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-300 rounded-md shadow-sm w-sm border border-gray-300" id="user-dropdown">
      <div class="px-4 py-3">
        <span class="block text-sm text-gray-800 truncate max-w-[30ch]">
          <%= current_user.full_name.titleize %>
        </span>
        <span class="block text-sm text-gray-600 truncate max-w-[30ch]">
          <%= "@#{current_user.username}" %>
        </span>
      </div>
      <ul class="py-2" aria-labelledby="user-menu-button">
        <li>
          <%= link_to "Account Settings", edit_super_admin_account_setting_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-gray-100" %>
        </li>
        <li>
          <%= button_to "Sign Out", session_path, method: :delete, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-gray-100 w-full text-left hover:cursor-pointer" %>
        </li>
      </ul>
    </div>
  </div>
<% end %>