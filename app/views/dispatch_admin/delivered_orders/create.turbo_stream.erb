<%= turbo_stream.replace "scan_form" do %>
  <%= render partial: "form",
      locals: {
        url: dispatch_admin_delivered_orders_path,
        scan_order: @scan_order
      } %>
<% end %>
<%= turbo_stream.replace "scan_alert" do %>
  <turbo-frame id="scan_alert">
    <% if @order.present? %>
      <div class="mt-4 bg-success-soft border border-success text-success p-4 rounded-md">
        Order <strong><%= @order.order_number %></strong> successfully delivered.
      </div>
    <% end %>
  </turbo-frame>
<% end %>
<%= turbo_stream.replace "scan_results" do %>
  <turbo-frame id="scan_results">
    <% if @order.present? %>
      <div class="mt-6">
        <%= render partial: "order_details", locals: { order: @order } %>
        <% if @order.order_batch.merchant.scan_sound.attached? %>
          <div data-controller="auto-play-audio">
            <audio
              preload="auto"
              data-auto-play-audio-target="audio"
              src="<%= url_for(@order.order_batch.merchant.scan_sound) %>" type="audio/mpeg"
            ></audio>
          </div>
        <% end %>
      </div>
    <% end %>
  </turbo-frame>
<% end %>
