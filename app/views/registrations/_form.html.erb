<%= form_with model: user, 
    url: url, 
    class: "flex h-full flex-col lg:justify-center gap-5" do |form| %>
  <div class="flex flex-col gap-2">
    <div class="py-10 flex lg:hidden">
      <%= link_to root_path, class: "py-0 lg:py-5 flex gap-2 items-center" do %>
        <div class="bg-dark rounded-md flex items-center justify-center border border-gray-300 h-10 w-10">
          <%= image_tag "logo.png", class: "w-6" %>
        </div>
        <h1 class="text-xl font-bold text-gray-800">Berkah Bandung</h1>
      <% end %>
    </div>
    <h1 class="text-4xl font-semibold text-gray-800">Registration</h1>
    <span class="text-sm text-gray-600">Enter your details to complete your registration.</span>
  </div>
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :full_name, label: "Full Name", required: true)) %>
    <%= render(TextInputComponent.new(form: form, field_name: :full_name, class: "mt-2", autofocus: true)) %>
    <%= render(ErrorInputComponent.new(model: user, field_name: :full_name)) %>
  </div>
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :username, label: "Username", required: true)) %>
    <%= render(TextInputComponent.new(form: form, field_name: :username, class: "mt-2", autofocus: true)) %>
    <%= render(ErrorInputComponent.new(model: user, field_name: :username)) %>
  </div>
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :password, label: "Password", required: true)) %>
    <%= render(PasswordInputComponent.new(form: form, field_name: :password, class: "mt-2")) %>
    <%= render(ErrorInputComponent.new(model: user, field_name: :password)) %>
  </div>
  <div>
    <%= render(LabelInputComponent.new(form: form, field_name: :password_confirmation, label: "Confirm Password", required: true)) %>
    <%= render(PasswordInputComponent.new(form: form, field_name: :password_confirmation, class: "mt-2")) %>
    <%= render(ErrorInputComponent.new(model: user, field_name: :password_confirmation)) %>
  </div>
  <%= render(ButtonComponent.new(type: :submit, size: "md", variant: "primary").with_content("Register")) %>
<% end %>