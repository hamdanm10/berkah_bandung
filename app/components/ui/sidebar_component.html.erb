<aside id="<%= sidebar_id %>" class="fixed top-0 left-0 z-50 w-64 h-screen transition-transform -translate-x-full lg:translate-x-0" aria-label="Sidebar">
  <div class="h-full px-3 py-8 overflow-y-auto bg-white border-r border-r-gray-300">
    <ul class="space-y-3 font-medium">
      <li>
        <div class="pb-5">
          <div class="flex items-center gap-2 ps-2">
            <div class="bg-white rounded-md flex items-center justify-center border border-gray-300 h-8 w-8">
              <%= image_tag "logo.svg", class: "w-4" %>
            </div>
            <h3 class="text-lg font-semibold text-gray-800">Berkah Bandung</h3>
          </div>
        </div>
      </li>
      <%= content %>
    </ul>
  </div>
</aside>