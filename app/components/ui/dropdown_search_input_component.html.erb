<div
  <%= tag.attributes(wrapper_kwargs) %>
  data-controller="dropdown-search"
  data-dropdown-search-selected-value="<%= selected_label %>"
>
  <%= form.text_field(
        label_field_name,
        value: selected_label,
        placeholder: prompt,
        autocomplete: "off",
        role: "combobox",
        aria: {
          autocomplete: "list",
          expanded: "false"
        },
        class: input_class,
        data: {
          dropdown_search_target: "input",
          action: "
            input->dropdown-search#search
            focus->dropdown-search#open
            keydown->dropdown-search#keydown
          "
        }
      ) %>
  <%= form.hidden_field(
        field_name,
        value: current_value,
        data: { dropdown_search_target: "hidden" }
      ) %>
  <div
    class="absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-md shadow hidden"
    role="listbox"
    data-dropdown-search-target="menu"
  >
    <% records.each do |label, value| %>
      <button
        type="button"
        role="option"
        tabindex="-1"
        class="text-sm text-gray-800 w-full text-left px-3 py-2 hover:bg-gray-100"
        data-action="click->dropdown-search#select"
        data-label="<%= label %>"
        data-value="<%= value %>"
        >
        <%= label %>
      </button>
    <% end %>
    <div
      class="px-3 py-2 text-sm text-gray-500 hidden"
      data-dropdown-search-target="empty"
    >
      Not found
    </div>
  </div>
</div>
