<%= search_form_for @q,
      url: @url,
      method: @method,
      class: "flex flex-wrap items-end gap-4",
      data: form_data do |f| %>
  <% @fields.each do |field| %>
    <div class="min-w-45">
      <% if field[:label].present? %>
        <label class="block mb-1 text-sm font-medium text-gray-700">
          <%= field[:label] %>
        </label>
      <% end %>
      <%= render_field(f, field) %>
    </div>
  <% end %>
  <% if show_submit_button? %>
    <div>
      <%= render(Ui::ButtonComponent.new(type: "submit", size: "sm", variant: "light")) do %>
        <%= lucide_icon("search", class: "size-5") %>
      <% end %>
    </div>
  <% end %>
<% end %>
