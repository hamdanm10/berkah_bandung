<div
  class="relative"
  data-controller="password-visibility"
>
  <%= form.password_field(
        field_name,
        **kwargs,
        data: {
          password_visibility_target: "input"
        }
      ) %>
  <button
    type="button"
    class="absolute inset-y-0 right-3 flex items-center text-gray-500 hover:text-gray-800 cursor-pointer"
    data-action="password-visibility#toggle"
  >
    <span data-password-visibility-target="eye">
      <%= lucide_icon "eye", class: "w-5 h-5" %>
    </span>
    <span data-password-visibility-target="eyeOff" class="hidden">
      <%= lucide_icon "eye-off", class: "w-5 h-5" %>
    </span>
  </button>
</div>
