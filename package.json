{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "bunx @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.20",
    "@stimulus-components/dialog": "^1.0.1",
    "@stimulus-components/notification": "^3.0.0",
    "@stimulus-components/rails-nested-form": "^5.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "chart.js": "^4.5.1",
    "chartkick": "^5.0.1",
    "flowbite": "^4.0.1",
    "tailwindcss": "^4.1.18"
  }
}